{
  "repo_name": "toy-shop-api",
  "files": [
    {
      "path": "app/models/user.py",
      "language": "python",
      "classes": [
        {
          "name": "User",
          "base_classes": ["Base"],
          "is_orm_model": true,
          "fields": [
            {"name": "id", "type": "Integer", "primary_key": true},
            {"name": "email", "type": "String", "unique": true},
            {"name": "orders", "type": "relationship", "target": "Order", "cascade": "all, delete-orphan"}
          ]
        }
      ]
    },
    {
      "path": "app/models/order.py",
      "language": "python",
      "classes": [
        {
          "name": "Order",
          "base_classes": ["Base"],
          "is_orm_model": true,
          "fields": [
            {"name": "id", "type": "Integer", "primary_key": true},
            {"name": "user_id", "type": "Integer", "foreign_key": "user.id"},
            {"name": "total_cents", "type": "Integer"},
            {"name": "status", "type": "String"}
          ]
        }
      ]
    },
    {
      "path": "app/routes/orders.py",
      "language": "python",
      "imports": ["app.models.order.Order", "app.models.user.User", "app.services.billing.charge_card"],
      "functions": [
        {
          "name": "create_order",
          "http_method": "POST",
          "route": "/orders",
          "calls": ["billing.charge_card", "db.session.add", "db.session.commit"],
          "mutates_models": ["Order", "User"]
        },
        {
          "name": "cancel_order",
          "http_method": "DELETE",
          "route": "/orders/{id}",
          "calls": ["db.session.delete", "db.session.commit"],
          "mutates_models": ["Order"]
        }
      ]
    },
    {
      "path": "app/services/billing.py",
      "language": "python",
      "functions": [
        {
          "name": "charge_card",
          "calls": ["stripe_client.charges.create"],
          "external_dependency": "stripe"
        }
      ]
    }
  ]
}
